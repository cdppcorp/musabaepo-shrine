# 무사배포 기원소 설정. 운영에서는 이 파일을 .env로 복사해 값을 채웁니다.
# NODE_ENV=production이면 '운영 필수' 값이 비었거나, 약하거나, 예시 그대로일 때 서버가 시작하지 않습니다.
# 무엇이 문제인지는 시작할 때 한꺼번에 보여 줍니다. 형식이 틀린 값(숫자 칸에 글자 등)은 개발에서도 시작하지 않습니다.
# 비밀 값이 들어간 .env는 저장소에 올리지 말고, 서버에서는 권한을 600으로 둡니다.

# production(운영) 또는 development(개발). 이름은 예전 Node 서버 때 쓰던 그대로입니다
NODE_ENV=production

# ── 서버 ──
PORT=3300
HOST=0.0.0.0
# 운영 도메인 (Caddy가 이 이름으로 https 인증서를 받습니다). DNS A 레코드를 이 서버 IP로
# 다른 프록시 뒤에 둘 때(아래 '다른 프록시 뒤')도 적습니다: 앱이 PUBLIC_ORIGIN과 같은 도메인인지 확인합니다
SHRINE_DOMAIN=shrine.example.com
# 운영 필수: 실제 접속 주소 (https://, 경로 없이). WebSocket · 입장 요청의 출처(Origin) 확인에 씁니다.
# SHRINE_DOMAIN과 같은 도메인이어야 하고, example.com 같은 예시 주소면 시작하지 않습니다.
# 다른 프록시 뒤에서도 방문자가 주소창에서 여는 주소(https://<도메인>) 그대로 적습니다 (다르면 실시간 연결이 403).
PUBLIC_ORIGIN=https://shrine.example.com
# 주소 앞부분. 독립 도메인 루트면 비워 둡니다 (다른 사이트 아래 /shrine 으로 붙일 때만 /shrine)
BASE_PATH=
# Caddy · nginx 같은 프록시 뒤에서만 true. 프록시 없이 직접 받으면 false (IP 위조 방지)
TRUST_PROXY=true
# 데이터(올린 이미지) 폴더. Docker에서는 compose가 /data(볼륨 api-data)로 정합니다.
DATA_DIR=./data

# ── 인증서 (Caddy) ──
# 배포 필수(단독 모드만): 인증서(ACME) 계정 메일. 발급 문제 · 약관 변경 안내가 옵니다. 비어 있으면 Caddy가 시작하지 않습니다.
# 다른 프록시 뒤(아래)에서는 앞단이 인증서를 받으므로 쓰지 않습니다. 비워 둬도 됩니다.
ACME_EMAIL=

# ── 다른 프록시 뒤에 둘 때 (선택, deploy/docker-compose.behind-proxy.yml · deploy/README.md 13장) ──
# 서버에 이미 nginx 같은 프록시가 80/443을 쓰면, Caddy는 아래 주소에서 평문 HTTP만 받고 https · 인증서는 앞단이 맡습니다.
# 단독 모드(기본)에서는 아래 값을 쓰지 않습니다.
# 모든 docker compose 명령에 덧씌우기 파일이 붙게 합니다 (deploy/ 폴더에서 실행할 때 기준).
# 넣어 두면 README의 C="docker compose --env-file ../.env"(업데이트 · 백업 cron 등)가 그대로 이 모드로 돕니다
# COMPOSE_FILE=docker-compose.yml:docker-compose.behind-proxy.yml
# Caddy가 받을 호스트 주소 (기본 172.17.0.1 = Docker 기본 브리지 게이트웨이, 서버 밖에서는 닿지 않음).
# 0.0.0.0이나 공인 IP는 쓰지 않습니다: Docker가 연 포트는 ufw를 거치지 않아 앞단을 건너뛴 접속이 생깁니다
# SHRINE_PROXY_BIND=172.17.0.1
# 포트 (기본 8111). 바꾸면 앞단 nginx의 proxy_pass도 같이
# SHRINE_PROXY_PORT=8111
# X-Forwarded-For를 믿을 앞단 주소 (공백으로 구분, 따옴표 없이). 기본은 사설 대역 전체
# SHRINE_TRUSTED_PROXIES=172.16.0.0/12 10.0.0.0/8 192.168.0.0/16 127.0.0.1/8

# ── 비밀 값 ──
# 운영 필수: 입장 표 서명 키 (32자 이상 무작위). 예시 글자 · 되풀이되는 값은 받지 않습니다.
# 만드는 법: openssl rand -hex 32
# 바꾸면 모든 접속자가 다시 입장해야 하고, 운영자 로그인 · IP 차단도 모두 풀립니다.
TICKET_SECRET=

# 운영 필수: Cloudflare Turnstile (사람 확인). Cloudflare 대시보드 → Turnstile에서 운영 도메인으로 발급
# Cloudflare 공개 시험 키(1x0000…, 2x0000…, 3x0000…)는 운영에서 받지 않습니다 (봇 차단이 꺼짐).
# 개발에서 둘 다 비우면 사람 확인을 건너뜁니다.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── 화면 · 기능 ──
# 검색 노출. 공개 전까지 false
ALLOW_INDEXING=false

# 직접 쓰는 채팅 (on/off, 기본 on). off면 고르는 말풍선만 남습니다.
# 운영자 화면(접속자)에서 서버를 띄운 동안만 켜고 끌 수 있고, 다시 띄우면 이 값으로 돌아갑니다.
FREE_CHAT=on

# AI 트렌드 게시판 글쓰기 · 글 신고 (on/off, 기본 off = 화면에 '준비 중'). off면 서버가 글 · 신고를 받지 않습니다.
BOARD_OPEN=

# 운영 필수: 화면 아래 · 개인정보 처리방침에 보이는 운영 연락처 (문제 있는 사당 · 개인정보 문의). 실제로 받는 메일
CONTACT_EMAIL=

# 등록소에서 GitHub 저장소가 공개 저장소인지 확인 (on/off, 기본 on)
GITHUB_CHECK=on
# (선택) GitHub API 토큰. 넣으면 서버 IP당 시간 60번 제한 대신 토큰 한도를 씁니다.
# 권한이 하나도 없는 fine-grained 토큰이면 충분합니다 (공개 저장소 정보만 읽음).
GITHUB_TOKEN=

# (시험용) 한 사람이 같은 사당에 초를 다시 켤 수 있을 때까지 ms. 비우면 30분(1800000)
# CANDLE_COOLDOWN_MS=

# 같은 IP에서 동시에 열 수 있는 실시간 연결 수 (기본 4). IPv6는 /64를 한 IP로 셉니다.
# 전체 정원이 60명이라 IP 몇 개로 다 채우지 못하게 낮춰 두었습니다. 통신사 CGNAT · 회사 · 행사장 Wi-Fi처럼
# 여러 사람이 IP 하나를 같이 쓰는 행사 때는 잠시 올려도 됩니다.
# WS_MAX_PER_IP=4

# ── 운영자 화면 (/admin) ──
# 16자 이상 무작위 비밀번호를 넣으면 켜지고, 비워 두면 꺼집니다 (/admin은 404).
# 운영에서는 약한 값(예시 글자 · 되풀이)이면 시작하지 않습니다.
# 만드는 법: openssl rand -base64 24
# 비밀번호를 바꾸고 서버를 다시 띄우면 열려 있던 운영자 로그인은 모두 끊깁니다.
ADMIN_PASSWORD=
# 운영자 화면을 열 수 있는 IP만 쉼표로 (예: 203.0.113.7,2001:db8::1). 비우면 IP 제한 없음.
# 넣어 두길 권합니다: 비어 있으면 운영에서 시작할 때 경고하고, 남이 서버 전체 로그인 잠금(15분 50번)을 걸어
# 운영자도 15분 동안 못 들어올 수 있습니다. 넣으면 전체 잠금은 쓰지 않고 IP별 잠금(15분 5번)만 씁니다.
# 프록시 뒤에서는 TRUST_PROXY=true여야 실제 접속 IP로 비교합니다 (프록시가 X-Forwarded-For를 덮어써야 함, Caddy 기본값).
ADMIN_IPS=

# ── 운영자 알림 ──
# (선택) 슬랙 · 디스코드 웹훅 주소. 새 접수 · 신고 · 서버 시작 · 비정상 종료 등을 짧게 알립니다 (이메일 같은 개인정보는 넣지 않음).
# 운영에서는 https://만 받습니다. 웹훅 주소 자체가 비밀이니 공개하지 않습니다.
NOTIFY_WEBHOOK_URL=

# ── 개인정보 보관 기간 (개인정보 처리방침의 숫자와 같아야 합니다) ──
# 반려되거나 작성자가 내린 접수의 이메일 · 비밀번호 해시 · 링크 · 이미지를 파기하기까지 (일, 기본 30)
RETENTION_DAYS=30
# 처리하지 못한 검토를 저절로 끝내기까지 (일, 기본 90)
PENDING_DAYS=90

# ── 백업 (python -m shrine.backup, Docker에서는 compose의 backup 서비스) ──
# 백업 파일을 둘 폴더 (기본 ./backups, Docker에서는 compose가 /backups로 정함 = 호스트 deploy/backups)
# BACKUP_DIR=./backups
# 최근 몇 개를 남길지 (기본 14)
BACKUP_KEEP=14
# 만든 지 이 일 수가 지난 백업은 개수와 관계없이 지웁니다 (기본 14, 파기한 개인정보가 백업에 오래 남지 않게)
BACKUP_MAX_DAYS=14
# (선택) 백업 서명 키 BACKUP_SIGNING_KEY는 이 파일에 넣지 않습니다. 앱 컨테이너가 이 파일을 통째로 받기
# 때문입니다. 운영자만 읽는 파일에 두고 백업 cron 스크립트가 넘깁니다 (deploy/README.md 7장 '서명').

# ── PostgreSQL · Redis ──
# 배포 필수 (deploy/docker-compose.yml): 16진 무작위 openssl rand -hex 24 (DB 주소에 그대로 들어가므로 @ : / 같은 글자는 쓰지 않습니다)
# 비어 있으면 docker compose가 시작하지 않습니다.
# 관리자(shrine, 슈퍼유저): postgres 컨테이너 안에서 백업 · 복구할 때만 씁니다. 네트워크로는 받지 않습니다.
POSTGRES_PASSWORD=
# 앱 전용 계정(shrine_app, 슈퍼유저 아님 · DB 주인): api가 이 계정으로 붙습니다 (compose가 DATABASE_URL을 만듦)
APP_DB_PASSWORD=
# Docker 밖(로컬 개발 · 일반 서버)에서만 직접 적습니다. Docker에서는 compose가 정하므로 이 파일의 값은 쓰이지 않습니다.
# DATABASE_URL=postgresql://shrine:<비밀번호>@127.0.0.1:5432/shrine
# REDIS_URL=redis://127.0.0.1:6379/0
