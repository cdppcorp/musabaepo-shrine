# 무사배포 기원소 설정. 운영에서는 이 파일을 .env로 복사해 값을 채웁니다.
# NODE_ENV=production이면 아래 '운영 필수' 값이 비어 있을 때 서버가 시작하지 않습니다.

NODE_ENV=production

# 서버
PORT=3300
HOST=0.0.0.0
# 운영 도메인 (Caddy가 이 이름으로 https 인증서를 받습니다). DNS A 레코드를 이 서버 IP로
SHRINE_DOMAIN=shrine.example.com
# 운영 필수: 실제 접속 주소. WebSocket · 입장 요청의 출처(Origin) 확인에 씁니다.
PUBLIC_ORIGIN=https://shrine.example.com
# 주소 앞부분. 독립 도메인 루트면 비워 둡니다 (다른 사이트 아래 /shrine 으로 붙일 때만 /shrine)
BASE_PATH=
# Caddy · nginx 같은 프록시 뒤에서만 true. 프록시 없이 직접 받으면 false (IP 위조 방지)
TRUST_PROXY=true
# 데이터(SQLite) 폴더. Docker에서는 볼륨에 연결합니다.
DATA_DIR=./data

# 운영 필수: 입장 표 서명 키 (32자 이상 무작위). 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=

# 운영 필수: Cloudflare Turnstile (사람 확인). Cloudflare 대시보드 → Turnstile에서 운영 도메인으로 발급
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# 검색 노출. 공개 전까지 false
ALLOW_INDEXING=false

# 직접 쓰는 채팅 (기본 켜짐). off면 고르는 말풍선만 남습니다
FREE_CHAT=on

# 화면에 보이는 운영 연락처 (문제 있는 사당 신고). 비우면 안 보입니다
CONTACT_EMAIL=
# 등록소에서 GitHub 저장소가 공개 저장소인지 확인 (off면 건너뜀)
GITHUB_CHECK=on
# (시험용) 한 사람이 같은 사당에 초를 다시 켤 수 있을 때까지 ms. 비우면 30분(1800000)
# CANDLE_COOLDOWN_MS=

# 운영자 화면 (/admin). 16자 이상 무작위 비밀번호를 넣으면 켜지고, 비워 두면 꺼집니다 (/admin은 404).
# 예: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 비밀번호를 바꾸고 서버를 다시 띄우면 열려 있던 운영자 로그인은 모두 끊깁니다.
ADMIN_PASSWORD=
# 운영자 화면을 열 수 있는 IP만 쉼표로 (예: 203.0.113.7,2001:db8::1). 비우면 IP 제한 없음.
# 프록시 뒤에서는 TRUST_PROXY=true여야 실제 접속 IP로 비교합니다 (프록시가 X-Forwarded-For를 덮어써야 함, Caddy 기본값).
ADMIN_IPS=
